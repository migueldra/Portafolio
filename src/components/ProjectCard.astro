---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'proyectos'>;
}

const { entry } = Astro.props;
const { title, summary, stack, repo, demo } = entry.data;
---

<article class="card">
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  {
    stack.length > 0 && (
      <ul class="tags">
        {stack.map((item) => (
          <li class="tag">{item}</li>
        ))}
      </ul>
    )
  }
  {
    (repo || demo) && (
      <p class="links">
        {repo && <a href={repo}>Repositorio</a>}
        {demo && <a href={demo}>Demo</a>}
      </p>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--color-surface);
    border: var(--border);
    border-top: 3px solid var(--color-defense);
    border-radius: var(--radius);
  }

  h3,
  p {
    margin: 0;
  }

  .summary {
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }
</style>
